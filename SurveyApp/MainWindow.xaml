<Window x:Class="SurveyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Гастрономічне опитування" Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1C1C1E">

    <Grid>
        <!-- Ліва помаранчева смуга -->
        <Rectangle Width="6" HorizontalAlignment="Left"
                   Fill="#FF7A2F" Opacity="0.9"/>

        <Grid Margin="38,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="&#x1F374; Гастрономічне опитування"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#FF7A2F"
                           FontFamily="Segoe UI"/>
                <TextBlock Text="Розкажіть нам про свої смаки"
                           FontSize="12" Foreground="#888888"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Прогрес -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="ProgressBar"
                             Grid.Column="0"
                             Height="5" Minimum="0"
                             VerticalAlignment="Center"
                             Foreground="#FF7A2F"
                             Background="#333333"/>
                <TextBlock x:Name="ProgressText"
                           Grid.Column="1"
                           FontSize="12" Foreground="#888888"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <!-- Картка питання -->
            <Border Grid.Row="2"
                    Background="#2A2422"
                    CornerRadius="2"
                    BorderBrush="#FF7A2F"
                    BorderThickness="0,0,0,2"
                    Padding="18,14"
                    Margin="0,0,0,14">
                <TextBlock x:Name="QuestionText"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#FFF5E6"
                           FontFamily="Segoe UI"
                           TextWrapping="Wrap"
                           LineHeight="24"/>
            </Border>

            <!-- Поле відповіді -->
            <Border Grid.Row="3"
                    Background="#242220"
                    CornerRadius="2"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    Margin="0,0,0,18">
                <TextBox x:Name="AnswerBox"
                         FontSize="14"
                         Foreground="#E8E0D8"
                         CaretBrush="#FF7A2F"
                         SelectionBrush="#FF7A2F"
                         BorderThickness="0"
                         Padding="14,12"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalAlignment="Stretch"
                         Background="Transparent"
                         FontFamily="Segoe UI"
                         KeyDown="AnswerBox_KeyDown"/>
            </Border>

            <!-- Кнопки -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="PrevButton"
                        Content="← Назад"
                        Click="PrevButton_Click"/>
                <Button Grid.Column="2" x:Name="NextButton"
                        Content="Далі →"
                        Click="NextButton_Click"/>
            </Grid>

            <!-- Статус -->
            <TextBlock Grid.Row="5"
                       x:Name="StatusText"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>
